# xAI Grok API — used only by 「診断を実行」
# Get a key at https://console.x.ai/
# The key stays on the server. It is NOT exposed to the browser.
# If you deploy publicly, every visitor's diagnosis uses THIS key's quota.
XAI_API_KEY=

# Optional: Postgres for production auth + history.
# Local/dev uses embedded PGLite when this is unset.
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DB

# Optional: public origin of this app (needed for OAuth callbacks)
# BETTER_AUTH_URL=https://your-domain.example
# BETTER_AUTH_SECRET=

# Optional: Grok auth broker credentials (only if you enable federated sign-in)
# GROK_AUTH_ISSUER=https://auth.grok.me
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=

# Sign-in is on by default. Set false to run without accounts.
# VITE_AUTH_ENABLED=false
